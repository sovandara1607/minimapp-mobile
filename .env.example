# Only needed to build for Android. iOS uses Apple Maps and needs nothing here.
#
# Get a free key: console.cloud.google.com -> create/select a project ->
# enable "Maps SDK for Android" -> Credentials -> Create API key.
# This is a Google account login, not Mapbox. Restrict the key to Android apps
# and your package name (com.minimapp.mobile) once you have one.
#
# Not prefixed with EXPO_PUBLIC_: it's only read at prebuild/build time to
# write the native AndroidManifest, never bundled into the JS app.
ANDROID_GOOGLE_MAPS_API_KEY=
